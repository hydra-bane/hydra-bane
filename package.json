{
  "name": "hydra-bane",
  "version": "0.2.1",
  "description": "Windows cleanup & hygiene CLI for AI coding agents. Nothing changes until you confirm; every change leaves an undoable receipt.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "os": [
    "win32"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "22.19.0",
    "fast-check": "4.10.2",
    "typescript": "7.0.2",
    "vitest": "5.0.2"
  },
  "bin": {
    "hydra-bane": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "TRADEMARK.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hydra-bane/hydra-bane.git"
  },
  "homepage": "https://github.com/hydra-bane/hydra-bane",
  "keywords": [
    "windows",
    "cleanup",
    "disk-space",
    "claude-code",
    "ai-agent",
    "undo",
    "quarantine"
  ],
  "publishConfig": {
    "provenance": true,
    "access": "public"
  }
}
